# Server Configuration
PORT=3000
NODE_ENV=production

# Login (AUTH_PASSWORD is required in production)
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=24
# true when the dashboard is opened over HTTPS (built-in HTTPS or a reverse proxy)
AUTH_COOKIE_SECURE=false
TRUST_PROXY=0

# Monitoring defaults (only used to create the initial config; change them in the dashboard later)
CHECK_INTERVAL_MINUTES=5
# Per-node timeout, at most 10 seconds (miaospeed's limit)
TIMEOUT_SECONDS=10
# Extra immediate probes after a failed probe (0-3)
RETRY_ATTEMPTS=1
# Consecutive failed checks before an offline alert is sent
FAILURE_THRESHOLD=2
# How often subscriptions are re-downloaded (minutes)
SUBSCRIPTION_REFRESH_MINUTES=30
# URL requested through each node (default http://www.gstatic.com/generate_204)
CUSTOM_HEALTH_CHECK_URL=

# miaospeed: runs every test (health checks, unlock checks, deep tests).
# The Docker image ships it; from source run `npm run setup:bin`.
# Local engine on the master; false = only use forward / reverse backends
MIAOSPEED_LOCAL=true
# Loopback port of the local engine
MIAOSPEED_PORT=23380
# Display name of the local backend (default 本机)
LOCAL_PROBE_NAME=
# Address reverse backends dial, e.g. wss://monitor.example.com (defaults to the dashboard address)
MIAOSPEED_PUBLIC_URL=
# Optional local GeoIP databases for topology tests (MaxMind format, comma separated)
MIAOSPEED_MMDB=

# Built-in HTTPS (the one-click installer configures this with --domain).
# HTTPS listener port; empty = HTTP only. The installer uses 3443 and publishes it as 443.
HTTPS_PORT=
# Certificate and key (PEM). HTTPS starts as soon as both exist and reloads them when renewed.
TLS_CERT_FILE=data/tls/fullchain.pem
TLS_KEY_FILE=data/tls/key.pem
# Served at /.well-known/acme-challenge/ on the HTTP port (Let's Encrypt HTTP-01 webroot)
ACME_WEBROOT=data/acme
# Redirect plain HTTP to HTTPS (except ACME challenges, /api/health, /api/ready, reverse links)
HTTPS_REDIRECT=false
# Port used in redirects when the public HTTPS port is not 443
HTTPS_PUBLIC_PORT=

# Bark Notification (iOS)
BARK_ENABLED=false
BARK_URL=

# Email Notification
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Telegram Notification
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
