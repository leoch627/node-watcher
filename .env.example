# Server Configuration
PORT=3000
NODE_ENV=production

# Login (AUTH_PASSWORD is required in production)
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=24
AUTH_COOKIE_SECURE=false
TRUST_PROXY=0

# Monitoring Configuration
CHECK_INTERVAL_MINUTES=5
TIMEOUT_SECONDS=10
CHECK_CONCURRENCY=8
# Extra immediate probes after a failed probe (0-3)
RETRY_ATTEMPTS=1
# Consecutive failed checks before an offline alert is sent
FAILURE_THRESHOLD=2
# How often subscriptions are re-downloaded (minutes)
SUBSCRIPTION_REFRESH_MINUTES=30
CUSTOM_HEALTH_CHECK_URL=

# Mihomo (optional overrides for local port conflicts)
MIHOMO_HTTP_PORT=23333
MIHOMO_SOCKS_PORT=23334
MIHOMO_CONTROLLER_PORT=23335
MIHOMO_SECRET=node-watcher-secret
# Parallel media-check slots (1-8, experimental; extra slots use ports starting at MIHOMO_HTTP_PORT+10)
MEDIA_CONCURRENCY=1

# miaospeed (deep tests). The Docker image ships it; from source run `npm run setup:bin`.
MIAOSPEED_LOCAL=true
MIAOSPEED_PORT=23380
# Address reverse backends dial, e.g. wss://monitor.example.com (defaults to the dashboard address)
MIAOSPEED_PUBLIC_URL=
# Optional local GeoIP databases for topology tests (MaxMind format, comma separated)
MIAOSPEED_MMDB=

# Bark Notification (iOS)
BARK_ENABLED=false
BARK_URL=

# Email Notification
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Telegram Notification
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Distributed probes (master side)
# TLS port remote probes connect to (running with npm start; 0 disables the listener).
# With docker-compose.yml the container always listens on 7443; set PROBE_HOST_PORT to publish it
# on another host port, or delete the probe port mapping to disable probes.
PROBE_PORT=7443
PROBE_HOST_PORT=7443
# Host name / IP written into join strings (defaults to the host used to open the dashboard)
PROBE_PUBLIC_HOST=
# Port written into join strings when it differs from PROBE_PORT (NAT, port mapping)
PROBE_PUBLIC_PORT=
# Whether the master itself also checks nodes; set false for a master that only aggregates probes
LOCAL_PROBE=true
LOCAL_PROBE_NAME=
