# Server Configuration
PORT=3000
NODE_ENV=production

# Login (AUTH_PASSWORD is required in production)
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=24
AUTH_COOKIE_SECURE=false
TRUST_PROXY=0

# Monitoring Configuration
CHECK_INTERVAL_MINUTES=5
TIMEOUT_SECONDS=10
CHECK_CONCURRENCY=8
CUSTOM_HEALTH_CHECK_URL=

# Mihomo (optional overrides for local port conflicts)
MIHOMO_HTTP_PORT=23333
MIHOMO_SOCKS_PORT=23334
MIHOMO_CONTROLLER_PORT=23335
MIHOMO_SECRET=node-watcher-secret

# Bark Notification (iOS)
BARK_ENABLED=false
BARK_URL=

# Email Notification
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Telegram Notification
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
